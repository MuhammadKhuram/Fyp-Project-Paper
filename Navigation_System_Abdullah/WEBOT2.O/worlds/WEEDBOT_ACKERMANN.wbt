    }
    # FL STEERING ASSEMBLY
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 0 1
        anchor 0.3 0.32 -0.05
      }
      device [
        PositionSensor {
          name "steer_fl_sensor"
        }
        RotationalMotor {
          name "steer_fl_motor"
          maxVelocity 10
            minPosition -0.785398
            maxPosition 0.785398
          maxTorque 50
        }
      ]
      endPoint Solid {
        translation 0.3 0.32 -0.05
        children [
          # Sprocket (moves with steering)
          Pose {
            translation 0 0 0.47
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 0.25 0.25 0.25
                  metalness 0.8
                }
                geometry Cylinder {
                  radius 0.04
                  height 0.01
                }
              }
            ]
          }
          # Fork Stem
          Shape {
            appearance PBRAppearance {
              baseColor 0.15 0.15 0.15
            }
            geometry Cylinder {
              radius 0.015
              height 0.03
            }
          }
