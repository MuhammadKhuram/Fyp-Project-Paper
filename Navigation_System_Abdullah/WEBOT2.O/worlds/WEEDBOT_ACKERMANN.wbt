  children [
    Lidar {
      translation 0.3 0 0.05
      horizontalResolution 180
      fieldOfView 3.14159
      numberOfLayers 1
      minRange 0.05
      maxRange 3
    }
    Pose {
      translation 0.3 0 0.11
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0 1 1
          }
          geometry Cone {
            bottomRadius 0.04
            height 0.1
          }
        }
