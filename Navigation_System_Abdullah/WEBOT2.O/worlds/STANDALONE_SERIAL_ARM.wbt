#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/appearances/protos/Soil.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  contactProperties [
    ContactProperties {
      material1 "wheel_diag_b"
      coulombFriction [
        0, 2, 0
      ]
      frictionRotation 0.785398 0
      bounce 0
      forceDependentSlip [
        10, 0
      ]
    }
    ContactProperties {
      material1 "wheel_diag_a"
      coulombFriction [
        0, 2, 0
      ]
      frictionRotation -0.785398 0
      bounce 0
      forceDependentSlip [
        10, 0
      ]
    }
  ]
}
Viewpoint {
  orientation -0.20946182374970712 0.0005449818771177394 0.9778166737104662 3.136517958947935
  position 5.16459083899344 -0.026984681967513607 3.024614632716123
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 10 10
  wallHeight 0.05
  floorAppearance Soil {
  }
}
Robot {
  translation 0 0 0.2
  rotation 0 0 1 0
  controller "serial_standalone"
  supervisor TRUE
  children [
    # Base Pedestal
    Pose {
      translation 0 0 -0.1
      children [ Shape { appearance PBRAppearance { baseColor 0.3 0.3 0.3 } geometry Cylinder { radius 0.08 height 0.2 } } ]
    }
    # Joint 1: Base Yaw
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 0 1 anchor 0 0 0 }
      device [ RotationalMotor { name "arm_motor_1" maxVelocity 3.0 maxTorque 50 } PositionSensor { name "arm_sensor_1" } ]
      endPoint Solid {
        name "arm_base"
        children [
          Shape { appearance PBRAppearance { baseColor 0.1 0.1 0.1 } geometry Cylinder { radius 0.05 height 0.06 } }
          # Joint 2: Shoulder Pitch
          HingeJoint {
            jointParameters HingeJointParameters { axis 0 1 0 anchor 0 0 0.03 }
            device [ RotationalMotor { name "arm_motor_2" maxVelocity 3.0 maxTorque 50 } PositionSensor { name "arm_sensor_2" } ]
            endPoint Solid {
              name "arm_upper_link"
              children [
                Pose { translation 0 0 0.06 children [ Shape { appearance PBRAppearance { baseColor 0.2 0.2 0.2 } geometry Cylinder { radius 0.016 height 0.12 } } ] }
                # Joint 3: Elbow Pitch
                HingeJoint {
                  jointParameters HingeJointParameters { axis 0 1 0 anchor 0 0 0.12 }
                  device [ RotationalMotor { name "arm_motor_3" maxVelocity 3.0 maxTorque 50 } PositionSensor { name "arm_sensor_3" } ]
                  endPoint Solid {
                    name "arm_forearm_link"
                    children [
                      Pose { translation 0 0 0.115 children [ Shape { appearance PBRAppearance { baseColor 0.4 0.4 0.4 } geometry Cylinder { radius 0.012 height 0.23 } } ] }
                      Pose { translation 0 0 0.23 children [ Shape { appearance PBRAppearance { baseColor 0.8 0.8 0.8 } geometry Cylinder { radius 0.035 height 0.005 } } ] }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
  name "serial_standalone"
}
